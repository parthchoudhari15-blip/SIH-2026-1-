// Transverse frame rail
// Hollow member spanning between front and rear rails.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import hollowMember from "hollowMember.kcl"
import machineWidth, frameProfile, tubeWall from "parameters.kcl"
export transverseRail = hollowMember(
  width = frameProfile,
  depth = frameProfile,
  wall = tubeWall,
  length = machineWidth - (2 * frameProfile),
)
  |> appearance(color = "#778690", metalness = 65, roughness = 35)
