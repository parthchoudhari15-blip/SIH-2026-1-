export deckHeight = 750mm
export tubeWall = 3mm
export rearServiceClearance = 350mm
export stationX = [130mm, 290mm, 480mm, 650mm, 790mm, 950mm, 1130mm, 1300mm, 1510mm, 1710mm, 1850mm]
