// Main corner column
// Hollow 40 mm post from foot plate to upper perimeter.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import hollowMember from "hollowMember.kcl"
import machineHeight, frameProfile, tubeWall from "parameters.kcl"
export column = hollowMember(
  width = frameProfile,
  depth = frameProfile,
  wall = tubeWall,
  length = machineHeight - (2 * frameProfile),
)
  |> appearance(color = "#778690", metalness = 65, roughness = 35)
